# Same scope mapping as the dashboard (Store/.npmrc). The credential itself must
# NOT live in a project .npmrc. Provide it out-of-repo instead:
#   local dev:  ~/.npmrc  ->  //npm.pkg.github.com/:_authToken=${GH_PACKAGES_TOKEN}
#   CI build:   pnpm config set "//npm.pkg.github.com/:_authToken" "$GH_PACKAGES_TOKEN"
# NOTE: GitHub Packages requires a CLASSIC PAT with read:packages; fine-grained
# tokens 403 (see SQ-system README "Consuming the packages").
# pnpm settings (autoInstallPeers, allowBuilds) live in pnpm-workspace.yaml.
@squaresharedev:registry=https://npm.pkg.github.com
